# ---------------------------------------------------------------------------
# Veil build-time configuration template
#
# Copy this file to `.env` (in the brave-core repository root, i.e.
# <workspace>/src/brave/.env) and fill in values only if you are producing an
# `is_official_build = true` release build.
#
# WHY THIS FILE EXISTS
#   Every flag below corresponds to a service that upstream Brave operates and
#   pays for. Upstream's own documentation is explicit that external developers
#   must supply their own values. A normal (non-official) developer build does
#   NOT require any of them.
#
# PRIVACY NOTE
#   These values are injected at BUILD TIME. Because Veil does not carry Brave's
#   production service credentials, a Veil developer build has no ability to
#   reach Brave's stats, sync, variations or AI service endpoints. That is a
#   property we intend to keep. See docs/privacy-model.md.
#
# NEVER COMMIT A REAL `.env`. It is gitignored. This template contains no
# secrets and must stay that way.
# ---------------------------------------------------------------------------

# --- Safe defaults for a local developer build ----------------------------
is_official_build=false
is_brave_release_build=false
dcheck_always_on=false
is_debug=false

# Skip upstream's feature-rollout ("Griffin") and statistics plumbing by
# leaving the endpoints/keys empty. Empty values are acceptable for
# non-official builds.
brave_variations_server_url=
brave_stats_api_key=
brave_stats_updater_url=
brave_sync_endpoint=

# --- Required only for is_official_build=true ------------------------------
# Supply YOUR OWN credentials if you ever produce an official build.
# Do not use Brave's.

# Google services
# brave_google_api_endpoint=
# brave_google_api_key=
# google_default_client_id=
# google_default_client_secret=
# safebrowsing_api_endpoint=

# Brave service keys (NOT PROVIDED — intentionally blank)
# brave_services_key=
# brave_services_key_id=
# brave_pref_hash_seed=
# email_aliases_api_key=

# Brave AI / speech service keys (NOT PROVIDED — intentionally blank, and
# Veil does not intend to ship these upstream AI integrations at all)
# service_key_aichat=
# service_key_stt=

# Build infrastructure
# goma_server_host=
# gclient_custom_deps=
# gclient_custom_vars=

# --- Android (only if targeting Android) -----------------------------------
# brave_android_developer_options_code=
# brave_android_key_password=
# brave_android_keystore_name=
# brave_android_keystore_password=
# brave_android_keystore_path=
# brave_safebrowsing_api_key=

# --- macOS (only if targeting macOS) ---------------------------------------
# notary_password=
# notary_user=
# sparkle_eddsa_private_key=
# sparkle_eddsa_public_key=
